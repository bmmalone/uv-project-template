{
    // ── Editor: layout and display ────────────────────────────────────────────
    "breadcrumbs.enabled": true,
    "editor.minimap.enabled": true,
    "editor.wordWrap": "on",
    "editor.rulers": [
        120
    ], // matches ruff line-length in pyproject.toml
    // ── Editor: formatting and whitespace ─────────────────────────────────────
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": true,
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    // ── Editor: visual aids ───────────────────────────────────────────────────
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.indentation": true,
    // ── Workbench ─────────────────────────────────────────────────────────────
    "explorer.compactFolders": true,
    "workbench.list.openMode": "singleClick",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.editor.revealIfOpen": true,
    // ── Python: interpreter and environment ───────────────────────────────────
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "python.terminal.useEnvFile": true,
    // ── Python: testing ───────────────────────────────────────────────────────
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "tests/unit/", // mirrors `make test`; fast, no external deps
        "--no-cov" // suppress coverage in the IDE test runner
    ],
    // ── Python: analysis ──────────────────────────────────────────────────────
    "python.analysis.extraPaths": [], // add src-layout paths here if needed
    "mypy-type-checker.importStrategy": "fromEnvironment",
    // ── Ruff: formatter and linter ────────────────────────────────────────────
    "ruff.importStrategy": "fromEnvironment",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
        }
    },
    // ── Search: excluded paths ────────────────────────────────────────────────
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/dist": true,
        "**/build": true,
        "**/__pycache__": true,
        "**/.venv": true,
        "**/.git": true
    },
    // ── Makefile ──────────────────────────────────────────────────────────────
    "makefile.configureOnOpen": false
}